<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="activities_management.RecurrenceDialog" owl="1">
        <div style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:10000;display:flex;align-items:center;justify-content:center;font-family:system-ui,-apple-system,sans-serif;">
            <div style="background:#fff;border-radius:16px;width:420px;max-width:95vw;max-height:80vh;overflow-y:auto;box-shadow:0 24px 48px rgba(0,0,0,0.25);animation:fadeIn 0.2s ease;">
                
                <!-- HEADER -->
                <div style="padding:20px 24px 0;">
                    <h3 style="margin:0;font-size:18px;font-weight:500;color:#202124;">Repeat</h3>
                </div>

                <!-- MODE OPTIONS -->
                <div style="padding:8px 0;">
                    <!-- Does not repeat -->
                    <label t-on-click="selectNone" style="display:flex;align-items:center;padding:12px 24px;cursor:pointer;font-size:14px;color:#202124;transition:background 0.15s;" onmouseover="this.style.background='#f1f3f4'" onmouseout="this.style.background='transparent'">
                        <input type="radio" name="rec_mode" value="none" t-att-checked="state.mode === 'none'" style="margin-right:16px;accent-color:#1a73e8;width:18px;height:18px;cursor:pointer;"/>
                        Does not repeat
                    </label>

                    <!-- Daily -->
                    <label t-on-click="selectDaily" style="display:flex;align-items:center;padding:12px 24px;cursor:pointer;font-size:14px;color:#202124;transition:background 0.15s;" onmouseover="this.style.background='#f1f3f4'" onmouseout="this.style.background='transparent'">
                        <input type="radio" name="rec_mode" value="daily" t-att-checked="state.mode === 'daily'" style="margin-right:16px;accent-color:#1a73e8;width:18px;height:18px;cursor:pointer;"/>
                        Daily
                    </label>

                    <!-- Weekly with dynamic label -->
                    <label t-on-click="selectWeekly" style="display:flex;align-items:center;padding:12px 24px;cursor:pointer;font-size:14px;color:#202124;transition:background 0.15s;" onmouseover="this.style.background='#f1f3f4'" onmouseout="this.style.background='transparent'">
                        <input type="radio" name="rec_mode" value="weekly" t-att-checked="state.mode === 'weekly'" style="margin-right:16px;accent-color:#1a73e8;width:18px;height:18px;cursor:pointer;"/>
                        <t t-esc="weeklyDayLabel"/>
                    </label>

                    <!-- Monthly with dynamic label -->
                    <label t-on-click="selectMonthly" style="display:flex;align-items:center;padding:12px 24px;cursor:pointer;font-size:14px;color:#202124;transition:background 0.15s;" onmouseover="this.style.background='#f1f3f4'" onmouseout="this.style.background='transparent'">
                        <input type="radio" name="rec_mode" value="monthly" t-att-checked="state.mode === 'monthly'" style="margin-right:16px;accent-color:#1a73e8;width:18px;height:18px;cursor:pointer;"/>
                        <t t-esc="monthlyLabel"/>
                    </label>

                    <!-- Yearly with dynamic label -->
                    <label t-on-click="selectYearly" style="display:flex;align-items:center;padding:12px 24px;cursor:pointer;font-size:14px;color:#202124;transition:background 0.15s;" onmouseover="this.style.background='#f1f3f4'" onmouseout="this.style.background='transparent'">
                        <input type="radio" name="rec_mode" value="yearly" t-att-checked="state.mode === 'yearly'" style="margin-right:16px;accent-color:#1a73e8;width:18px;height:18px;cursor:pointer;"/>
                        <t t-esc="yearlyLabel"/>
                    </label>

                    <!-- Custom -->
                    <label t-on-click="selectCustom" style="display:flex;align-items:center;padding:12px 24px;cursor:pointer;font-size:14px;color:#202124;transition:background 0.15s;" onmouseover="this.style.background='#f1f3f4'" onmouseout="this.style.background='transparent'">
                        <input type="radio" name="rec_mode" value="custom" t-att-checked="state.mode === 'custom'" style="margin-right:16px;accent-color:#1a73e8;width:18px;height:18px;cursor:pointer;"/>
                        Custom
                    </label>
                </div>

                <!-- INTERVAL (shown for all except none) -->
                <div t-if="state.mode !== 'none'" style="padding:16px 24px;border-top:1px solid #e8eaed;">
                    <div style="font-size:12px;color:#5f6368;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:8px;">Repeat every</div>
                    <div style="display:flex;align-items:center;gap:10px;">
                        <input type="number" t-model="state.interval" min="1" max="365" 
                               style="width:64px;padding:10px 12px;border:1px solid #dadce0;border-radius:8px;font-size:14px;outline:none;"/>
                        <span style="font-size:14px;color:#202124;"><t t-esc="modeLabel"/></span>
                    </div>
                </div>

                <!-- WEEKLY DAYS (shown when weekly) -->
                <div t-if="showDays" style="padding:16px 24px;">
                    <div style="font-size:12px;color:#5f6368;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:10px;">On these days</div>
                    <div style="display:flex;gap:6px;justify-content:space-between;">
                        <t t-foreach="dayNames" t-as="d" t-key="d_index">
                            <button t-on-click="() => toggleDay(d_index)" 
                                    style="width:46px;height:46px;border-radius:50%;border:none;cursor:pointer;font-size:14px;font-weight:500;transition:all 0.15s;"
                                    t-att-style="isDaySelected(d_index) ? 'background:#1a73e8;color:#fff;box-shadow:0 2px 8px rgba(26,115,232,0.3);' : 'background:#f1f3f4;color:#5f6368;'"
                                    onmouseover="if(!this.classList.contains('selected')) { this.style.background='#e8eaed'; }" 
                                    onmouseout="if(!this.classList.contains('selected')) { this.style.background='#f1f3f4'; }">
                                <t t-esc="d[0]"/>
                            </button>
                        </t>
                    </div>
                    <div t-if="selectedDaysList" style="margin-top:8px;font-size:12px;color:#5f6368;">
                        <t t-esc="selectedDaysList"/>
                    </div>
                </div>

                <!-- DAY OF MONTH (shown for monthly/yearly/custom) -->
                <div t-if="showDayOfMonth" style="padding:16px 24px;">
                    <div style="font-size:12px;color:#5f6368;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:8px;">Day of month</div>
                    <input type="number" t-model="state.dayOfMonth" min="1" max="31" 
                           style="width:64px;padding:10px 12px;border:1px solid #dadce0;border-radius:8px;font-size:14px;outline:none;"/>
                </div>

                <!-- MONTH (shown for yearly/custom) -->
                <div t-if="showMonth" style="padding:16px 24px;">
                    <div style="font-size:12px;color:#5f6368;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:8px;">Month</div>
                    <select t-model="state.month" style="width:100%;padding:10px 12px;border:1px solid #dadce0;border-radius:8px;font-size:14px;background:#fff;outline:none;cursor:pointer;">
                        <t t-foreach="monthNames" t-as="m" t-key="m_index">
                            <option t-att-value="m_index + 1"><t t-esc="m"/></option>
                        </t>
                    </select>
                </div>

                <!-- END OPTIONS (shown for all except none) -->
                <div t-if="state.mode !== 'none'" style="padding:16px 24px;border-top:1px solid #e8eaed;">
                    <div style="font-size:12px;color:#5f6368;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:10px;">Ends</div>
                    
                    <label style="display:flex;align-items:center;padding:6px 0;cursor:pointer;font-size:14px;color:#202124;">
                        <input type="radio" name="end" value="never" t-model="state.endType" style="margin-right:12px;accent-color:#1a73e8;width:16px;height:16px;"/> Never
                    </label>
                    
                    <label style="display:flex;align-items:center;padding:6px 0;cursor:pointer;font-size:14px;color:#202124;">
                        <input type="radio" name="end" value="date" t-model="state.endType" style="margin-right:12px;accent-color:#1a73e8;width:16px;height:16px;"/> On
                        <input t-if="state.endType === 'date'" type="date" t-model="state.endDate" 
                               style="margin-left:10px;padding:8px 10px;border:1px solid #dadce0;border-radius:8px;font-size:13px;outline:none;cursor:pointer;"/>
                    </label>
                    
                    <label style="display:flex;align-items:center;padding:6px 0;cursor:pointer;font-size:14px;color:#202124;">
                        <input type="radio" name="end" value="count" t-model="state.endType" style="margin-right:12px;accent-color:#1a73e8;width:16px;height:16px;"/> After
                        <input t-if="state.endType === 'count'" type="number" t-model="state.count" min="1" max="999" 
                               style="width:55px;margin:0 8px;padding:8px 10px;border:1px solid #dadce0;border-radius:8px;font-size:13px;outline:none;"/> occurrences
                    </label>
                </div>

                <!-- FOOTER -->
                <div style="padding:16px 24px;border-top:1px solid #e8eaed;display:flex;justify-content:flex-end;gap:12px;">
                    <button t-on-click="cancel" style="padding:10px 24px;border:none;background:none;color:#1a73e8;font-size:14px;font-weight:500;cursor:pointer;border-radius:8px;transition:background 0.15s;" onmouseover="this.style.background='#e8f0fe'" onmouseout="this.style.background='none'">Cancel</button>
                    <button t-on-click="save" style="padding:10px 32px;border:none;background:#1a73e8;color:#fff;font-size:14px;font-weight:500;cursor:pointer;border-radius:8px;transition:background 0.15s;" onmouseover="this.style.background='#1557b0'" onmouseout="this.style.background='#1a73e8'">Save</button>
                </div>
            </div>
        </div>
        
        <style>
            @keyframes fadeIn {
                from { opacity: 0; transform: translateY(10px); }
                to { opacity: 1; transform: translateY(0); }
            }
        </style>
    </t>
</templates>